{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    // `react-jsx` (automatic runtime) instead of `preserve` so that esbuild
    // - used by Wrangler when bundling the cf-worker, which now imports v1's
    // SatoriInvoiceTemplate.tsx for 1:1 parity - actually transforms JSX.
    // With `preserve` the bundle contained raw `<` tokens and the Worker
    // refused to start. Next.js compiles JSX via SWC (not tsc) so this only
    // affects how external bundlers see v1 .tsx files.
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
